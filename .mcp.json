{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "newrelic-preflight": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@newrelic/preflight@latest",
        "--stdio",
        "--config",
        "${CLAUDE_PROJECT_DIR:-.}/configuration/newrelic-preflight/config.json"
      ],
      "env": {}
    }
  }
}
